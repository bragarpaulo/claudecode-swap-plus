{
  "version": "0.2.0",
  "configurations": [
    {
      // F5: abre a extensão Swap Plus (plus/) num VS Code SEPARADO, com perfil próprio em dev/.dados/vscode/
      // (--user-data-dir e --extensions-dir), HOME, CLAUDE_CONFIG_DIR e TMPDIR de mentira. Não é uma janela deste
      // VS Code: um "extensionHost" comum abre o Extension Development Host como janela nova do VS Code que já está
      // aberto, e ele herda o perfil (configurações, segredos) dele — inclusive o acesso de um servidor de verdade.
      // Quem abre é o "node dev/ambiente-local.js vscode" (mesmo perfil do subcomando), com este VS Code como binário.
      // Outras portas: defina SWAP_PLUS_PORTAS=3018,3019,3020 no ambiente antes de abrir este VS Code.
      // Antes, suba o ambiente num terminal: node dev/ambiente-local.js
      // Para parar em breakpoints, use "Swap Plus (plus/) — ambiente local + depurador" (abre e se anexa ao host).
      "name": "Swap Plus (plus/) — ambiente local",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/dev/ambiente-local.js",
      "args": ["vscode", "--inspect-extensions=9339"],
      "env": {
        "CODE_BIN": "${execPath}",
        "SWAP_PLUS_PORTAS": "${env:SWAP_PLUS_PORTAS}"
      },
      "console": "internalConsole",
      "autoAttachChildProcesses": false
    },
    {
      "name": "Swap Plus — anexar ao host isolado (porta 9339)",
      "type": "node",
      "request": "attach",
      "port": 9339,
      "timeout": 60000,
      "continueOnAttach": true,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Original (claude-swap-status, só referência)",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "preLaunchTask": "${defaultBuildTask}"
    }
  
  ],
  "compounds": [
    {
      "name": "Swap Plus (plus/) — ambiente local + depurador",
      "configurations": ["Swap Plus (plus/) — ambiente local", "Swap Plus — anexar ao host isolado (porta 9339)"],
      "stopAll": true
    }
  ]
}
