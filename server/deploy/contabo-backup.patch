+stage_swap_plus() {
+  # Swap Plus Servidor (stack `swap-plus`): o cofre store.enc e a cópia anterior store.enc.1, os segredos (chave mestra
+  # e cliente Google) e o compose. O container continua rodando. O servidor grava o store.enc por rename atômico
+  # (temporário + fsync + rename), então o cp pega a versão velha ou a nova inteira, nunca metade; já o store.enc.1 é
+  # reescrito no lugar logo antes do rename. Por isso compara inode, tamanho e hora dos dois antes e depois da cópia e,
+  # se algum mudou no meio, copia de novo (até 5 vezes). Os temporários store.enc.tmp-* ficam de fora.
+  # O cofre sozinho não abre os logins: precisa da chave mestra, que vai junto no secrets.tar (o repositório restic tem
+  # senha própria). Lembrete: um refresh token é de uso único, então um cofre restaurado de horas atrás traz as contas
+  # renovadas depois disso como "precisa de login novo" (computadores, contas e regras voltam inteiros).
+  d=$STAGE/swap-plus; rm -rf "$d"; mkdir -p "$d"; chmod 700 "$d"
+  src=/opt/swap-plus/data
+  [ -s "$src/store.enc" ] || die "sem $src/store.enc"
+  n=0
+  while :; do
+    n=$((n + 1))
+    antes=$(stat -c '%i %s %y' "$src/store.enc" "$src/store.enc.1" 2>/dev/null || true)
+    cp -p "$src/store.enc" "$d/store.enc"
+    [ ! -e "$src/store.enc.1" ] || cp -p "$src/store.enc.1" "$d/store.enc.1"
+    depois=$(stat -c '%i %s %y' "$src/store.enc" "$src/store.enc.1" 2>/dev/null || true)
+    [ "$antes" != "$depois" ] || break
+    [ "$n" -lt 5 ] || die "o cofre do Swap Plus mudou durante as 5 cópias; nada enviado"
+    sleep 2
+  done
+  tar -C /etc/swap-plus -cf "$d/secrets.tar" secrets
+  # Recuperar TUDO (pedido do Paulo, 14/11/2026): além do cofre e dos segredos, a imagem em uso (docker save — ela é
+  # montada no servidor e não está em registry nenhum) e o código de onde ela foi montada (/opt/swap-plus/app).
+  img=$(docker container inspect -f '{{.Config.Image}}' swap-plus 2>/dev/null || true)
+  if [ -n "$img" ]; then
+    echo "$img" > "$d/imagem.txt"
+    # sem compressão: o restic deduplica os blocos e só a primeira cópia sobe
+    docker save "$img" > "$d/imagem.tar" || die "docker save $img falhou"
+  else
+    echo "(sem o container swap-plus)" > "$d/imagem.txt"
+  fi
+  tar -C /opt/swap-plus -cf "$d/app.tar" app
+  # O compose de verdade é o da stack (vai também no backup do Portainer, alvo servidor).
+  cp -a /opt/server-contabo/stacks/swap-plus/compose.yaml "$d/" 2>/dev/null || cp -a /opt/swap-plus/app/server/deploy/compose.yaml "$d/" 2>/dev/null || true
+  echo "$d"
+}
