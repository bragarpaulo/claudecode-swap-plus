#!/usr/bin/env python3
"""swap-plus-avisos — entrega ao servidor-aviso os avisos que o Swap Plus Servidor deixou para o dono (15/11/2026).

O container do Swap Plus não roda comandos do host: ele só grava arquivos aviso-*.json na caixa de saída dele
(/opt/swap-plus/data/avisos, mesmo formato do servidor-aviso: {id, assunto, texto, criado_em}). Este script, rodado
pelo cron a cada minuto (/etc/cron.d/swap-plus-avisos), confere cada arquivo, passa assunto e texto ao
`servidor-aviso` (que grava em /var/lib/servidor-avisos, de onde o Painel do Servidor manda o e-mail ao dono) e apaga
o arquivo entregue. Assim o Swap Plus não precisa de chave de e-mail nem de permissão na pasta do Painel.

Regras: nunca atrapalha o cron (sai sempre 0; erro vai para o syslog, etiqueta swap-plus-avisos); só lê arquivos com
nome válido e até 8 KB; arquivo estragado é apagado (com registro no syslog); no máximo 20 avisos por execução.
Uso (root): swap-plus-avisos        (ou SWAP_PLUS_AVISOS_DIR=/outra/pasta swap-plus-avisos, para ensaio)
"""
import json
import os
import re
import subprocess
import sys

PASTA = os.environ.get("SWAP_PLUS_AVISOS_DIR") or "/opt/swap-plus/data/avisos"
SERVIDOR_AVISO = os.environ.get("SERVIDOR_AVISO") or "/usr/local/sbin/servidor-aviso"
NOME = re.compile(r"^aviso-[A-Za-z0-9_-]{14,74}\.json$")
MAX_BYTES = 8 * 1024
MAX_POR_VEZ = 20

try:
    import syslog
except ImportError:  # fora do Linux (ensaio)
    syslog = None


def registrar(mensagem):
    try:
        if syslog:
            syslog.openlog("swap-plus-avisos", syslog.LOG_PID, syslog.LOG_DAEMON)
            syslog.syslog(syslog.LOG_WARNING, mensagem[:500])
        else:
            print("swap-plus-avisos: " + mensagem, file=sys.stderr)
    except Exception:  # noqa: BLE001
        pass


def apagar(caminho):
    try:
        os.remove(caminho)
    except OSError:
        pass


def main():
    try:
        nomes = sorted(n for n in os.listdir(PASTA) if NOME.match(n))
    except FileNotFoundError:
        return 0
    except OSError as e:
        registrar(f"não consegui ler {PASTA}: {e}")
        return 0
    for nome in nomes[:MAX_POR_VEZ]:
        caminho = os.path.join(PASTA, nome)
        try:
            if os.path.islink(caminho) or not os.path.isfile(caminho) or os.path.getsize(caminho) > MAX_BYTES:
                registrar(f"{nome}: não é um arquivo comum de até {MAX_BYTES} bytes; apagado")
                apagar(caminho)
                continue
            with open(caminho, encoding="utf-8") as f:
                aviso = json.load(f)
            assunto = aviso.get("assunto") if isinstance(aviso, dict) else None
            texto = aviso.get("texto") if isinstance(aviso, dict) else None
            if not isinstance(assunto, str) or not assunto.strip() or not isinstance(texto, str):
                registrar(f"{nome}: aviso sem assunto/texto; apagado")
                apagar(caminho)
                continue
            # O servidor-aviso corta, limpa e grava; ele sai sempre com 0 e registra os próprios erros.
            subprocess.run([SERVIDOR_AVISO, assunto, texto], timeout=20, check=False,
                           stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            apagar(caminho)
        except (ValueError, UnicodeDecodeError) as e:
            registrar(f"{nome}: JSON inválido ({e.__class__.__name__}); apagado")
            apagar(caminho)
        except Exception as e:  # noqa: BLE001 — nunca derrubar o cron; tenta de novo no próximo minuto
            registrar(f"{nome}: {e.__class__.__name__}: {e}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
